# ========================================================
# ОСНОВНЫЕ НАСТРОЙКИ TELEGRAM БОТА
# ========================================================
# Токен бота, полученный от @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ID администраторов Telegram через запятую (например: 12345678,87654321)
ADMIN_IDS=123456789

# Путь к файлу базы данных SQLite
# Для Railway рекомендуется подключить Volume к директории /data и указать:
# DB_PATH=/data/bot_database.sqlite3
DB_PATH=bot_database.sqlite3

# Радиусы действия (в метрах)
DANGER_RADIUS_METERS=500.0
BROADCAST_RADIUS_METERS=5000.0

# ========================================================
# РЕЖИМ РАБОТЫ (POLLING ИЛИ WEBHOOK)
# ========================================================
# Режим работы бота: "polling" (для локальной разработки) или "webhook" (для Railway / Production)
# Если переменная не указана, бот автоматически выберет "webhook", если доступен домен Railway.
MODE=polling

# ========================================================
# НАСТРОЙКИ ДЛЯ RAILWAY И WEBHOOK
# ========================================================
# Порт и хост сервера (Railway передает переменную PORT автоматически)
APP_HOST=0.0.0.0
PORT=8080

# Базовый публичный URL вашего сервиса (например: https://car-bot.up.railway.app)
# В Railway при включении публичного домена переменная RAILWAY_PUBLIC_DOMAIN подхватывается автоматически!
WEBHOOK_BASE_URL=

# Путь к вебхуку (эндпоинт)
WEBHOOK_PATH=/webhook

# Секретный токен для проверки подлинности запросов от Telegram (X-Telegram-Bot-Api-Secret-Token)
WEBHOOK_SECRET=super_secret_car_bot_token_12345
